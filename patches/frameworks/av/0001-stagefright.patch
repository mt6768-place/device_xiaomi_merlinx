Subject: [PATCH] stagefright: Fix hardware codec allocation for AOSP 16

---
 media/libstagefright/ACodec.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/media/libstagefright/ACodec.cpp b/media/libstagefright/ACodec.cpp
index 0000000..1111111 100644
--- a/media/libstagefright/ACodec.cpp
+++ b/media/libstagefright/ACodec.cpp
@@ -9338,7 +9338,11 @@ status_t ACodec::queryCapabilities(
                 param.eProfile, param.eLevel);
         }
     }
-
+    if (!isEncoder && strcasecmp(mime, MEDIA_MIMETYPE_VIDEO_AVC) == 0 &&
+        strncasecmp(name, "OMX.MTK.VIDEO.DECODER.AVC", 25) == 0) {
+        caps->addProfileLevel(OMX_VIDEO_AVCProfileHigh, OMX_VIDEO_AVCLevel42);
+        caps->addProfileLevel(OMX_VIDEO_AVCProfileConstrainedHigh, OMX_VIDEO_AVCLevel42);
+    }
 
     // Color format query
     // return colors in the order reported by the OMX component
